{
  "name": "nofilter-gpt",
  "displayName": "NoFilterGPT",
  "description": "A professional AI coding assistant powered by NoFilterGPT.",
  "version": "1.0.0",
  "main": "./extension.js",
  "repository": "https://github.com/aamu67659/nofiltergpt",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage",
    "onRender"
  ],
  "contributes": {
    "views": [
      {
        "id": "nofilter-chat",
        "name": "NoFilterGPT Chat",
        "type": "text",
        "location": "sidebar",
        "defaultHeight": 300
      }
    ],
    "commands": [
      {
        "command": "nofilter.explain",
        "title": "NoFilterGPT: Explain Selection"
      },
      {
        "command": "nofilter.refactor",
        "title": "NoFilterGPT: Refactor Selection"
      },
      {
        "command": "nofil.generate",
        "title": "NoFilterGPT: Generate New Function"
      }
    ]
  }
}